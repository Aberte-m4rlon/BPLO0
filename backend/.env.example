# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bplo_bongabong

# Session
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars
SESSION_MAX_AGE=86400000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Bootstrap admin account (required by npm run seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=BPLO Administrator
ADMIN_PHONE=

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
